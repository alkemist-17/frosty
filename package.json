{
  "name": "frosty",
  "version": "1.0.0",
  "description": "A lightweight, immutable, and type-safe global state management library for TypeScript.",
  "main": "./dist/frosty.test.js",
  "types": "./dist/frosty.test.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsx ./src/frosty.test.ts",
    "start": "tsx ./src/frosty.test.ts",
    "dev": "tsc && node ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkemist-17/frosty.git"
  },
  "keywords": [
    "immutable",
    "lightweight",
    "type-safe",
    "global state management",
    "state management",
    "typescript"
  ],
  "author": "Alkemist-17",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alkemist-17/frosty/issues"
  },
  "homepage": "https://github.com/alkemist-17/frosty#readme",
  "dependencies": {
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
